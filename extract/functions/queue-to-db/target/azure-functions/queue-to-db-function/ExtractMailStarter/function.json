{
  "scriptFile": "../queue-to-db-1.0.0.jar",
  "entryPoint": "com.microsoft.azure.functions.mailbox.ExtractMail.starter",
  "bindings": [
    {
      "type": "serviceBusTrigger",
      "direction": "in",
      "name": "message",
      "topicName": "%ServiceBusTopicName%",
      "subscriptionName": "%ServiceBusSubscriptionName%",
      "connection": "ServiceBusConnection"
    },
    {
      "type": "durableClient",
      "direction": "in",
      "name": "durableContext"
    }
  ]
}
