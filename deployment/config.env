# =============================================================================
# Example Configuration for extract-insight-action Infrastructure Deployment
# 
# Copy this file to config.env and customize with your values:
# cp config.example.env config.env
# 
# Then source it before running the deployment:
# source config.env
# ./deploy-infrastructure.sh
# =============================================================================

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Project name - will be used as prefix for all resource names
export PROJECT_NAME="eia"

# Environment name - dev, staging, prod, etc.
export ENVIRONMENT="dev"

# Azure region where resources will be deployed
# Common options: eastus, westus2, canadacentral, uksouth, australiaeast
export LOCATION="centralus"

# Your Azure subscription ID (leave empty to use current subscription)
# Get it with: az account show --query id -o tsv
export SUBSCRIPTION_ID=""

# =============================================================================
# OPTIONAL CONFIGURATION (uncomment and modify if needed)
# =============================================================================

# Custom resource names (if you don't want to use default naming convention)
# export RESOURCE_GROUP_NAME="rg-my-custom-name"
# export KEY_VAULT_NAME="kv-my-custom-name"
# export SERVICE_BUS_NAMESPACE="sb-my-custom-name"
# export STORAGE_ACCOUNT_NAME="stmycustomname"

# Service Bus configuration
# export SERVICE_BUS_TOPIC_NAME="email-processing"
# export SERVICE_BUS_SUBSCRIPTION_NAME="email-processor"

# Microsoft Graph API app registration
# export GRAPH_APP_NAME="my-custom-graph-app"
# If you have existing Graph API credentials, set them here:
# export GRAPH_CLIENT_ID="your-existing-client-id"
# export GRAPH_CLIENT_SECRET="your-existing-client-secret"

# Function app names
# export FUNCTION_APP_MAILBOX_NAME="func-mailbox-custom-name"
# export FUNCTION_APP_QUEUE_DB_NAME="func-queuedb-custom-name"

# Application Insights
# export APP_INSIGHTS_NAME="ai-custom-name"

# =============================================================================
# EXAMPLES FOR DIFFERENT ENVIRONMENTS
# =============================================================================

# Development Environment
# export PROJECT_NAME="extract-insight-action"
# export ENVIRONMENT="dev"
# export LOCATION="eastus"

# Staging Environment
# export PROJECT_NAME="extract-insight-action"
# export ENVIRONMENT="staging"
# export LOCATION="eastus"

# Production Environment
# export PROJECT_NAME="extract-insight-action"
# export ENVIRONMENT="prod"
# export LOCATION="eastus"

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Resource names will be automatically generated using the pattern:
#    {resource-type}-{PROJECT_NAME}-{ENVIRONMENT}
#    Example: rg-extract-insight-action-dev
#
# 2. Globally unique resources (Storage Account, Key Vault) will have
#    random suffixes added to avoid naming conflicts
#
# 3. Storage account names are limited to 24 characters and cannot contain
#    hyphens, so PROJECT_NAME hyphens will be removed
#
# 4. You can override any auto-generated name by setting the specific
#    environment variable (uncomment the lines above)
#